NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# Optional safety rails. Set these to fail fast if an environment points at the wrong Supabase project.
NEXT_PUBLIC_STAGING_SUPABASE_PROJECT_REF=your-staging-project-ref
NEXT_PUBLIC_PRODUCTION_SUPABASE_PROJECT_REF=your-production-project-ref
